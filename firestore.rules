rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Participants are identified by their verified sign-in email.
    function isParticipant(d) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in d.participants;
    }

    function optNumber(v) {
      return v == null || (v is number && v >= 0);
    }

    function boundedString(v, max) {
      return v is string && v.size() <= max;
    }

    function validJump(d) {
      return d.keys().hasOnly([
          'jumpNumber', 'date', 'time', 'dropzone', 'aircraft', 'jumpType',
          'exitAltitude', 'deploymentAltitude', 'freefallTime',
          'canopy', 'notes', 'participants', 'ownerName', 'createdAt', 'updatedAt'
        ])
        && d.jumpNumber is int && d.jumpNumber > 0
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('time' in d) || (d.time is string
            && (d.time == '' || d.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]$'))))
        && boundedString(d.dropzone, 200)
        && boundedString(d.aircraft, 200)
        && boundedString(d.jumpType, 100)
        && boundedString(d.canopy, 200)
        && boundedString(d.notes, 10000)
        && optNumber(d.exitAltitude)
        && optNumber(d.deploymentAltitude)
        && optNumber(d.freefallTime)
        && (!('participants' in d) || (d.participants is list && d.participants.size() <= 50))
        && (!('ownerName' in d) || boundedString(d.ownerName, 200));
    }

    match /users/{userId}/jumps/{jumpId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && validJump(request.resource.data);
    }

    // Covers both direct links (get) and the "Shared with me" collection-group query (list).
    match /{path=**}/jumps/{jumpId} {
      allow read: if isParticipant(resource.data);
    }
  }
}
